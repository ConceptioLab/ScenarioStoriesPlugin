Configuration scenariostories.conf {
	target Capella
	project org.polarsys.capella.vp.scenariostories
	nsuri "http://www.polarsys.org/capella/scenariostories"
	release {
		version : 1.0.0.qualifier
		description : "Viewpoint Description"
		execution environments : "JavaSE-1.6"
	}
	generation {
		data (
			Model: true
			Edit: true
			Editor: false
			Test: false
			Javadoc: false
			OverwriteEcore: true
		)
		diagram (
			OverwriteOdesign: false // Do not overwrite .odesign!
		)
		documentation (
			EcoreToHtml: false
		)
	}
}