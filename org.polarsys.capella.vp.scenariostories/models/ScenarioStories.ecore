<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="ScenarioStories" nsURI="http://www.polarsys.org/capella/scenariostories"
    nsPrefix="ScenarioStories">
  <eClassifiers xsi:type="ecore:EClass" name="ScenarioStoriesFolder" eSuperTypes="platform:/plugin/org.polarsys.capella.core.data.gen/model/CapellaCore.ecore#//NamedElement platform:/plugin/org.polarsys.kitalpha.emde/model/eMDE.ecore#//ElementExtension">
    <eAnnotations source="http://www.polarsys.org/kitalpha/emde/1.0.0/constraint">
      <details key="ExtendedElement" value=" http://www.polarsys.org/capella/core/oa/6.0.0#//OperationalAnalysis"/>
    </eAnnotations>
    <eAnnotations source="http://www.polarsys.org/kitalpha/emde/1.0.0/constraintMapping">
      <details key="Mapping" value=" platform:/plugin/org.polarsys.capella.core.data.gen/model/OperationalAnalysis.ecore#//OperationalAnalysis"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedScenarios" upperBound="-1"
        eType="#//ScenarioContainer" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="diagramUIDs" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ScenarioContainer" eSuperTypes="platform:/plugin/org.polarsys.capella.core.data.gen/model/CapellaCore.ecore#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedComponents" upperBound="-1"
        eType="#//AbstractStoryComponent" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AbstractStoryComponent" abstract="true"
      eSuperTypes="platform:/plugin/org.polarsys.capella.core.data.gen/model/CapellaCore.ecore#//NamedElement"/>
  <eClassifiers xsi:type="ecore:EClass" name="BasicEvent" eSuperTypes="#//AbstractStoryComponent"/>
  <eClassifiers xsi:type="ecore:EClass" name="BasicElement" eSuperTypes="#//AbstractStoryComponent"/>
  <eClassifiers xsi:type="ecore:EClass" name="BasicGroup" eSuperTypes="#//AbstractStoryComponent">
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedComponents" upperBound="-1"
        eType="#//AbstractStoryComponent" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BasicEdge" eSuperTypes="#//AbstractStoryComponent">
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceComponent" eType="#//AbstractStoryComponent"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetComponent" eType="#//AbstractStoryComponent"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="WhenEdge" eSuperTypes="#//BasicEdge"/>
  <eClassifiers xsi:type="ecore:EClass" name="GivenEdge" eSuperTypes="#//BasicEdge"/>
  <eClassifiers xsi:type="ecore:EClass" name="ThenEdge" eSuperTypes="#//BasicEdge"/>
  <eClassifiers xsi:type="ecore:EClass" name="AndEdge" eSuperTypes="#//BasicEdge"/>
</ecore:EPackage>
